<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- List every installed app -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- "Remove App" menu action -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only used to read the wallpaper bitmap for the glass blur (Android 13+ hides it otherwise) -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Weather widget only: forecasts and city search from Open-Meteo (no account, no API key) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Weather widget, "Current Location" option only: approximate position for the forecast -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar "Up Next" widget: shows your upcoming events, asked when you tap the widget -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- localeConfig (per-app language list) only exists on Android 13+; older versions ignore it. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZFL"
        tools:targetApi="33">

        <!-- System-bound only. Notification access authorizes MediaSession queries, shows clock
             activities (running timers, stopwatches, ringing alarms) in the Island and, when turned
             on, counts notifications per app for icon badges (package, user and flags only; no text
             is read). Nothing is stored. No started service or foreground playback service. -->
        <!-- Optional Island, enabled by the user: owns the one window around the camera. An
             accessibility overlay is the only window above the status bar, where the capsule must
             be touchable. It receives no events, cannot read the screen and performs no actions. -->
        <service
            android:name=".island.IslandWindowService"
            android:label="@string/island_title"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/island_window_service" />
        </service>

        <service
            android:name=".island.IslandListenerService"
            android:label="@string/island_title"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Every type: badges count messages (conversations) and quiet notifications (silent);
                 timers are ongoing, ringing alarms alerting. Each consumer filters in code. The
                 system keeps the types stored for an existing grant; the user changes them on the
                 listener's page in system settings. -->
            <meta-data android:name="android.service.notification.default_filter_types" android:value="conversations|alerting|silent|ongoing" />
        </service>

        <!-- The home screen is a fixed portrait grid, like iOS: it never rotates and is never shown
             in split screen. Android 16 ignores this only on large screens (600dp+). -->

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity,NonResizeableActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Launcher settings: the "ZFL Launcher" icon in the app grid opens this. Portrait like
             the home screen its previews show. A language change (onboarding) is applied in place:
             Compose re-reads the strings, so the screen doesn't flash while it is recreated. -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ZFL.Settings"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
